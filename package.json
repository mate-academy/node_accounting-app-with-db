  "license": "GPL-3.0",
  "dependencies": {
    "@prisma/client": "5.16.1",
    "close-with-grace": "^1.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.12.0",
    "prisma": "^7.2.0",
    "sequelize": "^6.37.7"
  },
  "mateAcademy": {
    "projectType": "nodeJs"
  },
  "devDependencies": {
    "@types/node": "^25.0.3"
  }
